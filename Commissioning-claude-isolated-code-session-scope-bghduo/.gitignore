# Dependencies
node_modules/

# Local runtime configuration — holds real Power Automate SAS URLs.
# A SAS URL is a credential; never commit these. Copy the matching
# config.example.js and fill it in locally instead.
config/config.local.js
document-portal/config.local.js

# Ad-hoc runtime state exports
*.state.json

# Test output
test-results/
playwright-report/
blob-report/
.playwright/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# The 17MB reference archive. Extracted to docs/reference/ and removed from the
# working tree — see docs/cutover/ARCHIVE_DISPOSITION.md. Still in git history.
ECM_DOCS_DEV.zip

# Built deployment packages (npm run package). Each carries a provisioned
# config.local.js — a credential. Never commit one.
dist/

# Package bundles (npm run package:bundle). These embed the endpoint
# configuration UNREDACTED — signed trigger URLs in full. Never commit one.
*.bundle.json
.scratch/
.scratch2/

# Written by scripts/provision-sharepoint-fields.ps1 — a run record, not source
sharepoint-field-ledger.csv

# Written by scripts/export-power-automate-flows.ps1 before review. Move exports you intend
# to keep into docs/reference/flow-contracts/ and attribute them in the register.
docs/reference/flow-contracts/exported/

# Generated by scripts/build-readiness-tracker.mjs. The published artifact is the live
# record once anyone edits it; a committed snapshot would be stale immediately.
readiness-tracker.html
dist-bundle/

# Python bytecode (tools/flow-workbench)
__pycache__/
*.pyc

# The single-file console export. Built on demand from docs/reference/provisioning/
# by `npm run provisioningconsole:one`; the folder in docs/ is the committed form.
dist-console/

# ── Derived documentation ────────────────────────────────────────────────────
# Printed from a tracked source by a builder in scripts/. Committing them put
# the same facts in two places and let the copy drift: every one below was
# verified to rebuild BYTE-IDENTICALLY from what this repository already holds,
# so nothing is lost by not carrying them.
#
# `npm run generate` rebuilds the set, and `npm run test:node` runs it first.
# The builders are listed in scripts/generate-all.builders.
#
# Do NOT add a file here unless its builder reproduces it exactly. A document
# that is merely ABOUT a generated thing — docs/deployment/README.md,
# docs/reference/README.md — is hand-written and belongs in the tree.

# The provisioned state, printed out of the packages — `npm run provisioning`
# and `npm run provisioningconsole`. 136 files, 15 MB, the largest single
# derived tree in the repository. console.css, console.js and index.html are
# the console's hand-written source and STAY tracked.
docs/reference/provisioning/README.md
docs/reference/provisioning/ENDPOINT_REGISTER.md
docs/reference/provisioning/flows/
docs/reference/provisioning/packages/
docs/reference/provisioning/provisioning-detail.js
docs/reference/provisioning/provisioning-index.js

