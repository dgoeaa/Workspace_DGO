{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh:*)",
      "Bash(git clone:*)",
      "Bash(git remote:*)",
      "Bash(git worktree:*)",
      "Bash(git submodule:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(rm -rf .claude:*)",
      "Read(~/.claude/projects/**)",
      "Read(~/.claude/sessions/**)",
      "Read(~/.claude/shell-snapshots/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/branch_lock.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/branch_lock.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/branch_lock.py\""
          }
        ]
      }
    ]
  }
}
