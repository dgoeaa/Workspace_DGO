# NITDA Folio Workspace: browser caching (shipped at the site root by scripts/package.mjs).
#
# The host's default kept JavaScript for 30 days (max-age=2592000). After a redeploy a browser
# then ran a mix of old and new ES modules, and the Workspace could stall after sign-in without
# an error (2026-10-09). Code, pages and data are revalidated on every load instead: an
# unchanged file costs a 304, and a new deployment is picked up at once. Images and fonts
# keep the host's caching.
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|m?js|css|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
