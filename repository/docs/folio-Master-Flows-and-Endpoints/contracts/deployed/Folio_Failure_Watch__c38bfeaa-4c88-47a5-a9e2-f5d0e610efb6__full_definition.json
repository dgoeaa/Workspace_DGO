            "type": "Compose",
            "inputs": {
              "listed": "@if(outputs('Compose_Watch_Config')?['summary'],body('Filter_Open_Reported'),body('Filter_New_Reported'))",
              "burst": "@greaterOrEquals(length(body('Select_New_Failures')),outputs('Compose_Watch_Config')?['burst'])",
              "summary": "@outputs('Compose_Watch_Config')?['summary']",
              "newCount": "@length(body('Select_New_Failures'))",
              "openCount": "@length(body('Select_Open_Failures'))",
              "open": {
                "citizen": "@length(body('Filter_Open_Citizen'))",
                "codes": "@length(body('Filter_Open_Codes'))",
                "staff": "@length(body('Filter_Open_Staff'))",
                "ops": "@length(body('Filter_Open_Ops'))",
                "outward": "@length(body('Filter_Open_Outward'))",
                "unclassified": "@length(body('Filter_Open_Unclassified'))"
              },
              "readNew": "@equals(string(coalesce(actions('Get_New_Failures')?['status'],'')),'Succeeded')",
              "readOpen": "@equals(string(coalesce(actions('Get_Open_Failures')?['status'],'')),'Succeeded')"
            }
          },
          "Condition_Watch_Report": {
            "actions": {
              "Select_Watch_Rows": {
                "runAfter": {},
                "type": "Select",
                "inputs": {
                  "from": "@outputs('Compose_Watch_Outcome')?['listed']",
                  "select": "@concat('<tr><td style=\"padding:8px 10px;border-bottom:1px solid #E8E6E7;font:600 13px Arial,sans-serif;color:#05583B;word-break:break-all\">',replace(replace(replace(replace(replace(string(item()?['ref']),'&','&amp;'),'<','&lt;'),'>','&gt;'),'\"','&quot;'),'''','&#39;'),'</td><td style=\"padding:8px 10px;border-bottom:1px solid #E8E6E7;font:13px Arial,sans-serif;color:#1B1A1A\">',replace(replace(replace(replace(replace(string(item()?['type']),'&','&amp;'),'<','&lt;'),'>','&gt;'),'\"','&quot;'),'''','&#39;'),'</td><td style=\"padding:8px 10px;border-bottom:1px solid #E8E6E7;font:13px Arial,sans-serif;color:#1B1A1A\">',replace(replace(replace(replace(replace(string(item()?['to']),'&','&amp;'),'<','&lt;'),'>','&gt;'),'\"','&quot;'),'''','&#39;'),'</td><td style=\"padding:8px 10px;border-bottom:1px solid #E8E6E7;font:13px Arial,sans-serif;color:#5F5C5D\">',replace(replace(replace(replace(replace(string(item()?['error']),'&','&amp;'),'<','&lt;'),'>','&gt;'),'\"','&quot;'),'''','&#39;'),'</td><td style=\"padding:8px 10px;border-bottom:1px solid #E8E6E7;font:13px Arial,sans-serif;color:#5F5C5D;white-space:nowrap\">',replace(replace(replace(replace(replace(string(item()?['at']),'&','&amp;'),'<','&lt;'),'>','&gt;'),'\"','&quot;'),'''','&#39;'),'</td></tr>')"
                }
