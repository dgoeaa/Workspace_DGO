              "from": "@coalesce(actions('Get_Open_Failures')?['outputs']?['body']?['value'],json('[]'))",
              "select": {
                "group": "@string(coalesce(json('{\"IP_OTP_GENERATE|an-email-v2\":\"codes\",\"Folio_Incoming_Correspondence_Scan_Processing_Flow|an-email-v2\":\"ops\"}')?[concat(split(concat(string(coalesce(item()?['Title'],'')),'::'),':')[1],'|',string(coalesce(item()?['MessageType'],'')))],json('{\"sender-acknowledgement\":\"citizen\",\"status-acknowledged\":\"citizen\",\"status-actionrequired\":\"citizen\",\"status-approved\":\"citizen\",\"status-declined\":\"citizen\",\"status-progress\":\"citizen\",\"status-withdrawn\":\"citizen\",\"citizen-note\":\"citizen\",\"citizen-respond\":\"citizen\",\"citizen-withdraw\":\"citizen\",\"support-acknowledgement\":\"citizen\",\"support-reply\":\"citizen\",\"case\":\"citizen\",\"expired-upload\":\"citizen\",\"verification-code\":\"codes\",\"report-delivery\":\"staff\",\"an-email-v2-main-1-1-1\":\"staff\",\"an-email-v2-main-5\":\"staff\",\"task-digest\":\"staff\",\"registry-alert\":\"ops\",\"registry-digest\":\"ops\",\"helpdesk-alert\":\"ops\",\"lockout-alert\":\"ops\",\"rate-limit-alert\":\"ops\",\"server-error-alert\":\"ops\",\"writeback-alert\":\"ops\",\"dgo-scan-notification\":\"ops\",\"telemetry\":\"ops\",\"undeliverable-alert\":\"ops\",\"undelivered-alert\":\"ops\",\"bulk-failure\":\"ops\",\"failure-watch\":\"ops\",\"outward-correspondence\":\"outward\"}')?[string(coalesce(item()?['MessageType'],''))],'unclassified'))",
                "id": "@item()?['ID']",
                "type": "@string(coalesce(item()?['MessageType'],''))",
                "to": "@if(or(empty(toLower(trim(string(coalesce(item()?['RecipientEmail'],''))))),not(contains(toLower(trim(string(coalesce(item()?['RecipientEmail'],'')))),'@'))),'',concat(substring(concat(toLower(trim(string(coalesce(item()?['RecipientEmail'],'')))),' '),0,1),'***@',last(split(toLower(trim(string(coalesce(item()?['RecipientEmail'],'')))),'@'))))",
                "ref": "@string(coalesce(item()?['Reference'],''))",
                "error": "@if(empty(string(coalesce(item()?['LastError'],''))),'',substring(string(coalesce(item()?['LastError'],'')),0,min(length(string(coalesce(item()?['LastError'],''))),200)))",
                "at": "@if(empty(string(coalesce(item()?['Created'],''))),'',formatDateTime(convertFromUtc(if(empty(string(coalesce(item()?['Created'],''))),'1970-01-01T00:00:00Z',item()?['Created']),'W. Central Africa Standard Time'),'d MMM HH:mm'))"
              }
            }
          },
          "Filter_New_Reported": {
            "runAfter": {
              "Select_Open_Failures": [
                "Succeeded"
              ]
            },
            "type": "Query",
            "inputs": {
              "from": "@body('Select_New_Failures')",
              "where": "@or(equals(item()?['group'],'unclassified'),contains(split(outputs('Compose_Watch_Config')?['groups'],','),item()?['group']))"
            }
          },
          "Filter_Open_Reported": {
            "runAfter": {
              "Filter_New_Reported": [
                "Succeeded"
              ]
            },
            "type": "Query",
            "inputs": {
              "from": "@body('Select_Open_Failures')",
              "where": "@or(equals(item()?['group'],'unclassified'),contains(split(outputs('Compose_Watch_Config')?['groups'],','),item()?['group']))"
            }
          },
          "Filter_Open_Citizen": {
            "runAfter": {
              "Filter_Open_Reported": [
