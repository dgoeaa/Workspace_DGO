              "to": "@if(empty(trim(string(xpath(outputs('Compose_Watch_Config_Xml'),'string(/r/i[k=\"NOTIFY_FAILURE_REPORT_TO\"]/v)')))),'dgsregistry@nitda.gov.ng',trim(string(xpath(outputs('Compose_Watch_Config_Xml'),'string(/r/i[k=\"NOTIFY_FAILURE_REPORT_TO\"]/v)'))))",
              "cursor": "@if(empty(trim(string(xpath(outputs('Compose_Watch_Config_Xml'),'string(/r/i[k=\"NOTIFY_FAILURE_WATCH_CURSOR\"]/v)')))),formatDateTime(addHours(outputs('Compose_Watch_Start'),-1),'yyyy-MM-ddTHH:mm:ssZ'),if(startsWith(trim(string(xpath(outputs('Compose_Watch_Config_Xml'),'string(/r/i[k=\"NOTIFY_FAILURE_WATCH_CURSOR\"]/v)'))),'utc:'),replace(trim(string(xpath(outputs('Compose_Watch_Config_Xml'),'string(/r/i[k=\"NOTIFY_FAILURE_WATCH_CURSOR\"]/v)'))),'utc:',''),formatDateTime(if(or(empty(trim(string(xpath(outputs('Compose_Watch_Config_Xml'),'string(/r/i[k=\"NOTIFY_FAILURE_WATCH_CURSOR\"]/v)')))),startsWith(trim(string(xpath(outputs('Compose_Watch_Config_Xml'),'string(/r/i[k=\"NOTIFY_FAILURE_WATCH_CURSOR\"]/v)'))),'utc:')),'1970-01-01T00:00:00Z',trim(string(xpath(outputs('Compose_Watch_Config_Xml'),'string(/r/i[k=\"NOTIFY_FAILURE_WATCH_CURSOR\"]/v)')))),'yyyy-MM-ddTHH:mm:ssZ')))",
              "summary": "@equals(int(formatDateTime(convertFromUtc(outputs('Compose_Watch_Start'),'W. Central Africa Standard Time'),'HH')),7)"
            }
