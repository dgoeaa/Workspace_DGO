{
  "exportedBy": "Tenant capture (docs/folio-Master-Flows-and-Endpoints/captures, 2026-10-01)",
  "exportedAtUtc": "2026-10-01",
  "derivedFrom": "docs/folio-Master-Flows-and-Endpoints/captures/IP_Retrieve_Email_Attachment_Endpoint__5bc87cf3-7a99-4259-b6a2-315fbc794d9b.json",
  "workflow_identity": {
    "internal_name": "5bc87cf3-7a99-4259-b6a2-315fbc794d9b",
    "full_resource_id": "/providers/Microsoft.Flow/flows/5bc87cf3-7a99-4259-b6a2-315fbc794d9b",
    "tags": {
      "flowDisplayName": "IP_Retrieve_Email_Attachment_Endpoint"
    }
  },
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "undefined",
    "parameters": {
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      },
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      }
    },
    "triggers": {
      "manual": {
        "metadata": {},
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "triggerAuthenticationType": "All"
        }
      }
    },
    "actions": {
      "Scope_Email_Attachment_Endpoint_REBUILT": {
        "actions": {
          "Scope_Try_Email_Attachments": {
            "actions": {
              "Compose_EmailMessageId": {
                "type": "Compose",
                "inputs": "@trim(string(coalesce(triggerBody()?['emailId'],'')))"
              },
              "Condition_EmailId_Valid": {
                "actions": {
                  "Get_email_V2": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "messageId": "@outputs('Compose_EmailMessageId')",
                        "includeAttachments": true
                      },
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                        "connectionName": "shared_office365-2",
                        "operationId": "GetEmailV2"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  },
                  "Apply_to_each_Attachment": {
                    "foreach": "@coalesce(outputs('Get_email_V2')?['body/attachments'],json('[]'))",
                    "actions": {
                      "Get_Attachment_V2": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "messageId": "@outputs('Get_email_V2')?['body/id']",
                            "attachmentId": "@items('Apply_to_each_Attachment')?['id']"
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                            "connectionName": "shared_office365-2",
                            "operationId": "GetAttachment_V2"
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      },
                      "Condition_Attachment_Content_Valid": {
                        "actions": {
                          "Append_Attachment": {
                            "type": "AppendToArrayVariable",
                            "inputs": {
                              "name": "varAttachments",
                              "value": {
                                "Name": "@string(outputs('Get_Attachment_V2')?['body/name'])",
                                "ContentType": "@string(coalesce(outputs('Get_Attachment_V2')?['body/contentType'],'application/octet-stream'))",
                                "ContentBytes": "@outputs('Get_Attachment_V2')?['body/contentBytes']"
                              }
                            }
                          }
                        },
                        "runAfter": {
                          "Get_Attachment_V2": [
                            "Succeeded"
                          ]
                        },
                        "else": {
                          "actions": {
                            "Append_Invalid_Attachment_Error": {
                              "type": "AppendToArrayVariable",
                              "inputs": {
                                "name": "varErrors",
                                "value": {
                                  "code": "ATTACHMENT_CONTENT_UNAVAILABLE",
                                  "message": "An attachment was omitted because its name or content was unavailable.",
                                  "attachmentId": "@string(coalesce(items('Apply_to_each_Attachment')?['id'],''))"
                                }
                              }
                            }
                          }
                        },
                        "expression": {
                          "and": [
                            {
                              "equals": [
                                "@not(empty(outputs('Get_Attachment_V2')?['body/name']))",
                                true
                              ]
                            },
                            {
                              "equals": [
                                "@not(empty(outputs('Get_Attachment_V2')?['body/contentBytes']))",
                                true
                              ]
                            }
                          ]
                        },
                        "type": "If"
                      }
                    },
                    "runAfter": {
                      "Get_email_V2": [
                        "Succeeded"
                      ]
                    },
                    "type": "Foreach",
                    "runtimeConfiguration": {
                      "concurrency": {
                        "repetitions": 1
                      }
                    }
                  },
                  "Set_Success_Data": {
                    "runAfter": {
                      "Apply_to_each_Attachment": [
                        "Succeeded"
                      ]
                    },
                    "type": "SetVariable",
                    "inputs": {
                      "name": "varData",
                      "value": {
                        "emailId": "@outputs('Compose_EmailMessageId')",
                        "attachmentCount": "@length(variables('varAttachments'))",
                        "attachments": "@variables('varAttachments')"
                      }
                    }
                  },
                  "Set_Success_Status": {
                    "runAfter": {
                      "Set_Success_Data": [
                        "Succeeded"
                      ]
                    },
                    "type": "SetVariable",
                    "inputs": {
                      "name": "varStatusCode",
                      "value": 200
                    }
                  },
                  "Set_Success_Outcome": {
                    "runAfter": {
                      "Set_Success_Status": [
                        "Succeeded"
                      ]
                    },
                    "type": "SetVariable",
                    "inputs": {
                      "name": "varOutcomeCode",
                      "value": "EMAIL_ATTACHMENTS_RETRIEVED"
                    }
                  }
                },
                "runAfter": {
                  "Compose_EmailMessageId": [
                    "Succeeded"
                  ]
                },
                "else": {
                  "actions": {
                    "Set_Invalid_Data": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "varData",
                        "value": {
                          "emailId": "",
                          "attachmentCount": 0,
                          "attachments": []
                        }
                      }
                    },
                    "Append_Invalid_Request_Error": {
                      "runAfter": {
                        "Set_Invalid_Data": [
                          "Succeeded"
                        ]
                      },
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "varErrors",
                        "value": {
                          "code": "EMAIL_ID_REQUIRED",
                          "message": "The emailId property is required and must not be empty."
                        }
                      }
                    },
                    "Set_Invalid_Status": {
                      "runAfter": {
                        "Append_Invalid_Request_Error": [
                          "Succeeded"
                        ]
                      },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "varStatusCode",
                        "value": 400
                      }
                    },
                    "Set_Invalid_Outcome": {
                      "runAfter": {
                        "Set_Invalid_Status": [
                          "Succeeded"
                        ]
                      },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "varOutcomeCode",
                        "value": "INVALID_REQUEST"
                      }
                    }
                  }
                },
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@not(empty(outputs('Compose_EmailMessageId')))",
                        true
                      ]
                    }
                  ]
                },
                "type": "If"
              }
            },
            "type": "Scope"
          },
          "Scope_Catch_Email_Attachments": {
            "actions": {
              "Set_Catch_Status": {
                "type": "SetVariable",
                "inputs": {
                  "name": "varStatusCode",
                  "value": 500
                }
              },
              "Set_Catch_Outcome": {
                "runAfter": {
                  "Set_Catch_Status": [
                    "Succeeded"
                  ]
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "varOutcomeCode",
                  "value": "EMAIL_ATTACHMENT_RETRIEVAL_FAILED"
                }
              },
              "Set_Catch_Data": {
                "runAfter": {
                  "Set_Catch_Outcome": [
                    "Succeeded"
                  ]
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "varData",
                  "value": {
                    "emailId": "@trim(string(coalesce(triggerBody()?['emailId'],'')))",
                    "attachmentCount": "@length(variables('varAttachments'))",
                    "attachments": []
                  }
                }
              },
              "Append_Catch_Error": {
                "runAfter": {
                  "Set_Catch_Data": [
                    "Succeeded"
                  ]
                },
                "type": "AppendToArrayVariable",
                "inputs": {
                  "name": "varErrors",
                  "value": {
                    "code": "DEPENDENCY_OR_PROCESSING_FAILURE",
                    "message": "The email or its attachments could not be retrieved.",
                    "stage": "email-attachment-processing",
                    "trackedAtUtc": "@utcNow()"
                  }
                }
              }
            },
            "runAfter": {
              "Scope_Try_Email_Attachments": [
                "Failed",
                "TimedOut"
              ]
            },
            "type": "Scope"
          },
          "Scope_Finalize_Email_Attachments": {
            "actions": {
              "Set_CompletedAtUtc": {
                "type": "SetVariable",
                "inputs": {
                  "name": "varCompletedAtUtc",
                  "value": "@utcNow()"
                }
              },
              "Set_DurationMs": {
                "runAfter": {
                  "Set_CompletedAtUtc": [
                    "Succeeded"
                  ]
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "varDurationMs",
                  "value": "@div(sub(ticks(variables('varCompletedAtUtc')),variables('varStartTicks')),10000)"
                }
              },
              "Compose_Standard_Response": {
                "runAfter": {
                  "Set_DurationMs": [
                    "Succeeded"
                  ]
                },
                "type": "Compose",
                "inputs": {
                  "ok": "@less(variables('varStatusCode'),400)",
                  "status": {
                    "http": "@variables('varStatusCode')",
                    "code": "@variables('varOutcomeCode')",
                    "message": "@if(less(variables('varStatusCode'),400),'Request completed successfully.','Request could not be completed.')"
                  },
                  "request": {
                    "requestId": "@variables('varRequestId')",
                    "emailId": "@trim(string(coalesce(triggerBody()?['emailId'],'')))"
                  },
                  "timing": {
                    "receivedAtUtc": "@variables('varReceivedAtUtc')",
                    "completedAtUtc": "@variables('varCompletedAtUtc')",
                    "durationMs": "@variables('varDurationMs')"
                  },
                  "data": "@variables('varData')",
                  "errors": "@variables('varErrors')",
                  "meta": {
                    "runId": "@workflow()?['run']?['name']",
                    "flowName": "@workflow()?['name']",
                    "contractVersion": "2026-09-18.1"
                  }
                }
              },
              "Response_Email_Attachments": {
                "runAfter": {
                  "Compose_Standard_Response": [
                    "Succeeded"
                  ]
                },
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": "@variables('varStatusCode')",
                  "headers": {
                    "Content-Type": "application/json",
                    "Cache-Control": "no-store",
                    "X-Content-Type-Options": "nosniff",
                    "X-Correlation-ID": "@variables('varRequestId')"
                  },
                  "body": "@outputs('Compose_Standard_Response')"
                }
              }
            },
            "runAfter": {
              "Scope_Try_Email_Attachments": [
                "Succeeded",
                "Failed",
                "TimedOut"
              ],
              "Scope_Catch_Email_Attachments": [
                "Succeeded",
                "Skipped"
              ]
            },
            "type": "Scope"
          }
        },
        "runAfter": {
          "Initialize_varRequestId": [
            "Succeeded"
          ]
        },
        "type": "Scope"
      },
      "Initialize_varReceivedAtUtc": {
        "runAfter": {},
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "varReceivedAtUtc",
              "type": "String",
              "value": "@utcNow()"
            }
          ]
        }
      },
      "Initialize_varStartTicks": {
        "runAfter": {
          "Initialize_varReceivedAtUtc": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "varStartTicks",
              "type": "Integer",
              "value": "@ticks(utcNow())"
            }
          ]
        }
      },
      "Initialize_varCompletedAtUtc": {
        "runAfter": {
          "Initialize_varStartTicks": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "varCompletedAtUtc",
              "type": "String",
              "value": ""
            }
          ]
        }
      },
      "Initialize_varDurationMs": {
        "runAfter": {
          "Initialize_varCompletedAtUtc": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "varDurationMs",
              "type": "Integer",
              "value": 0
            }
          ]
        }
      },
      "Initialize_varStatusCode": {
        "runAfter": {
          "Initialize_varDurationMs": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "varStatusCode",
              "type": "Integer",
              "value": 500
            }
          ]
        }
      },
      "Initialize_varOutcomeCode": {
        "runAfter": {
          "Initialize_varStatusCode": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "varOutcomeCode",
              "type": "String",
              "value": "INTERNAL_PROCESSING_ERROR"
            }
          ]
        }
      },
      "Initialize_varErrors": {
        "runAfter": {
          "Initialize_varOutcomeCode": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "varErrors",
              "type": "Array",
              "value": []
            }
          ]
        }
      },
      "Initialize_varAttachments": {
        "runAfter": {
          "Initialize_varErrors": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "varAttachments",
              "type": "array"
            }
          ]
        }
      },
      "Initialize_varData": {
        "runAfter": {
          "Initialize_varAttachments": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "varData",
              "type": "Object",
              "value": {}
            }
          ]
        }
      },
      "Initialize_varRequestId": {
        "runAfter": {
          "Initialize_varData": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "varRequestId",
              "type": "String",
              "value": "@guid()"
            }
          ]
        }
      }
    }
  }
}
