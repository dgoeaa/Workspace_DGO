{
  "nodeId": "Scope_Email_Attachment_Endpoint_REBUILT",
  "serializedValue": {
    "actions": {
      "Scope_Try_Email_Attachments": {
        "actions": {
          "Compose_EmailMessageId": {
            "type": "Compose",
            "inputs": "@trim(string(coalesce(triggerBody()?['emailId'],'')))",
            "runAfter": {
              "Compose_Attachments_Gate_Auth": [
                "Succeeded"
              ]
            }
          },
          "Condition_EmailId_Valid": {
            "actions": {
              "Get_email_V2": {
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "messageId": "@outputs('Compose_EmailMessageId')",
                    "includeAttachments": true
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                    "connection": "shared_office365-2",
                    "operationId": "GetEmailV2"
                  }
                }
              },
              "Apply_to_each_Attachment": {
                "foreach": "@coalesce(outputs('Get_email_V2')?['body/attachments'],json('[]'))",
                "actions": {
                  "Get_Attachment_V2": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "messageId": "@outputs('Get_email_V2')?['body/id']",
                        "attachmentId": "@items('Apply_to_each_Attachment')?['id']"
                      },
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                        "connection": "shared_office365-2",
                        "operationId": "GetAttachment_V2"
                      }
                    }
                  },
                  "Condition_Attachment_Content_Valid": {
                    "actions": {
                      "Append_Attachment": {
                        "type": "AppendToArrayVariable",
                        "inputs": {
                          "name": "varAttachments",
                          "value": {
                            "Name": "@string(outputs('Get_Attachment_V2')?['body/name'])",
                            "ContentType": "@string(coalesce(outputs('Get_Attachment_V2')?['body/contentType'],'application/octet-stream'))",
                            "ContentBytes": "@outputs('Get_Attachment_V2')?['body/contentBytes']"
                          }
                        }
                      }
                    },
                    "runAfter": {
                      "Get_Attachment_V2": [
                        "Succeeded"
                      ]
                    },
                    "else": {
                      "actions": {
                        "Append_Invalid_Attachment_Error": {
                          "type": "AppendToArrayVariable",
                          "inputs": {
                            "name": "varErrors",
                            "value": {
                              "code": "ATTACHMENT_CONTENT_UNAVAILABLE",
                              "message": "An attachment was omitted because its name or content was unavailable.",
                              "attachmentId": "@string(coalesce(items('Apply_to_each_Attachment')?['id'],''))"
                            }
                          }
                        }
                      }
                    },
                    "expression": {
                      "and": [
                        {
                          "equals": [
                            "@not(empty(outputs('Get_Attachment_V2')?['body/name']))",
                            true
                          ]
                        },
                        {
                          "equals": [
                            "@not(empty(outputs('Get_Attachment_V2')?['body/contentBytes']))",
                            true
                          ]
                        }
                      ]
                    },
                    "type": "If"
                  }
                },
                "runAfter": {
                  "Get_email_V2": [
                    "Succeeded"
                  ]
                },
                "type": "Foreach",
                "runtimeConfiguration": {
                  "concurrency": {
                    "repetitions": 1
                  }
                }
              },
              "Set_Success_Data": {
                "runAfter": {
                  "Compose_Value_Set_Success_Data": [
                    "Succeeded"
                  ]
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "varData",
                  "value": "@outputs('Compose_Value_Set_Success_Data')"
                }
              },
              "Set_Success_Status": {
                "runAfter": {
                  "Set_Success_Data": [
                    "Succeeded"
                  ]
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "varStatusCode",
                  "value": 200
                }
              },
              "Set_Success_Outcome": {
                "runAfter": {
                  "Set_Success_Status": [
                    "Succeeded"
                  ]
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "varOutcomeCode",
                  "value": "EMAIL_ATTACHMENTS_RETRIEVED"
                }
              },
              "Compose_Value_Set_Success_Data": {
                "type": "Compose",
                "inputs": {
                  "emailId": "@outputs('Compose_EmailMessageId')",
                  "attachmentCount": "@length(variables('varAttachments'))",
                  "attachments": "@variables('varAttachments')"
                },
                "runAfter": {
                  "Apply_to_each_Attachment": [
                    "Succeeded"
                  ]
                }
              }
            },
            "runAfter": {
              "Compose_EmailMessageId": [
                "Succeeded"
              ]
            },
            "else": {
              "actions": {
                "Set_Invalid_Data": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "varData",
                    "value": "@outputs('Compose_Value_Set_Invalid_Data')"
                  },
                  "runAfter": {
                    "Compose_Value_Set_Invalid_Data": [
                      "Succeeded"
                    ]
                  }
                },
                "Append_Invalid_Request_Error": {
                  "runAfter": {
                    "Set_Invalid_Data": [
                      "Succeeded"
                    ]
                  },
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "varErrors",
                    "value": {
                      "code": "@if(equals(outputs('Compose_Attachments_Gate_Auth'),'ok'),'EMAIL_ID_REQUIRED','UNAUTHENTICATED')",
                      "message": "@if(equals(outputs('Compose_Attachments_Gate_Auth'),'ok'),'The emailId property is required and must not be empty.','A valid sign-in is required.')"
                    }
                  }
                },
                "Set_Invalid_Status": {
                  "runAfter": {
                    "Compose_Value_Set_Invalid_Status": [
                      "Succeeded"
                    ]
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "varStatusCode",
                    "value": "@outputs('Compose_Value_Set_Invalid_Status')"
                  }
                },
                "Set_Invalid_Outcome": {
                  "runAfter": {
                    "Compose_Value_Set_Invalid_Outcome": [
                      "Succeeded"
                    ]
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "varOutcomeCode",
                    "value": "@outputs('Compose_Value_Set_Invalid_Outcome')"
                  }
                },
                "Compose_Value_Set_Invalid_Data": {
                  "type": "Compose",
                  "inputs": {
                    "emailId": "",
                    "attachmentCount": 0,
                    "attachments": []
                  }
                },
                "Compose_Value_Set_Invalid_Status": {
                  "type": "Compose",
                  "inputs": "@if(equals(outputs('Compose_Attachments_Gate_Auth'),'ok'),400,401)",
                  "runAfter": {
                    "Append_Invalid_Request_Error": [
                      "Succeeded"
                    ]
                  }
                },
                "Compose_Value_Set_Invalid_Outcome": {
                  "type": "Compose",
                  "inputs": "@if(equals(outputs('Compose_Attachments_Gate_Auth'),'ok'),'INVALID_REQUEST','UNAUTHENTICATED')",
                  "runAfter": {
                    "Set_Invalid_Status": [
                      "Succeeded"
                    ]
                  }
                }
              }
            },
            "expression": {
              "and": [
                {
                  "equals": [
                    "@equals(outputs('Compose_Attachments_Gate_Auth'),'ok')",
                    true
                  ]
                },
                {
                  "equals": [
                    "@not(empty(outputs('Compose_EmailMessageId')))",
                    true
                  ]
                }
              ]
            },
            "type": "If"
          },
          "Get_Attachments_Gate_Proof_Mode": {
            "type": "OpenApiConnection",
            "runAfter": {},
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                "connection": "shared_sharepointonline",
                "operationId": "GetItems"
              },
              "parameters": {
                "dataset": "https://nitdanigeria.sharepoint.com/sites/NITDADGO-EAAACTIVITYTRACKING",
                "table": "9bc168c3-06e5-4d58-982b-0df06205fd35",
                "$filter": "Title eq 'IDENTITY_PROOF_REQUIRED'",
                "$top": 1
              }
            }
          },
          "Compose_Attachments_Gate_Proof_Token": {
            "type": "Compose",
            "inputs": "@trim(replace(replace(string(coalesce(triggerOutputs()?['headers']?['X-DGO-Proof'],triggerOutputs()?['headers']?['x-dgo-proof'],triggerOutputs()?['headers']?['Authorization'],triggerOutputs()?['headers']?['authorization'],'')),'Bearer ',''),'bearer ',''))",
            "runAfter": {
              "Get_Attachments_Gate_Proof_Mode": [
                "Succeeded"
              ]
            }
          },
          "Get_Attachments_Gate_Proof": {
            "type": "OpenApiConnection",
            "runAfter": {
              "Compose_Attachments_Gate_Proof_Token": [
                "Succeeded"
              ]
            },
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                "connection": "shared_sharepointonline",
                "operationId": "GetItems"
              },
              "parameters": {
                "dataset": "https://nitdanigeria.sharepoint.com/sites/DGO_ECM_GOVERNANCE",
                "table": "444102d6-2c29-45cf-8b59-52774d7c4dd4",
                "$filter": "@if(empty(outputs('Compose_Attachments_Gate_Proof_Token')),'ID eq 0',concat('Title eq ''',replace(outputs('Compose_Attachments_Gate_Proof_Token'),'''',''''''),''' and Consumed eq 0 and Purpose eq ''internal-session'''))",
                "$top": 1
              }
            }
          },
          "Compose_Attachments_Gate_Identity": {
            "type": "Compose",
            "inputs": {
              "proofRequired": "@equals(toLower(trim(string(coalesce(first(coalesce(outputs('Get_Attachments_Gate_Proof_Mode')?['body/value'],json('[]')))?['ConfigValue'],'')))),'true')",
              "proofValid": "@and(not(empty(outputs('Compose_Attachments_Gate_Proof_Token'))),greater(length(coalesce(outputs('Get_Attachments_Gate_Proof')?['body/value'],json('[]'))),0),greater(ticks(coalesce(first(coalesce(outputs('Get_Attachments_Gate_Proof')?['body/value'],json('[]')))?['ExpiresAtUtc'],'1900-01-01T00:00:00Z')),ticks(utcNow())))"
            },
            "runAfter": {
              "Get_Attachments_Gate_Proof": [
                "Succeeded"
              ]
            }
          },
          "Compose_Attachments_Gate_Caller": {
            "type": "Compose",
            "inputs": "@if(outputs('Compose_Attachments_Gate_Identity')?['proofValid'],toLower(trim(string(coalesce(first(coalesce(outputs('Get_Attachments_Gate_Proof')?['body/value'],json('[]')))?['Email'],'')))),if(outputs('Compose_Attachments_Gate_Identity')?['proofRequired'],'',toLower(trim(string(coalesce(coalesce(triggerBody()?['userEmail'],triggerBody()?['payload']?['userEmail']),''))))))",
            "runAfter": {
              "Compose_Attachments_Gate_Identity": [
                "Succeeded"
              ]
            }
          },
          "Get_Attachments_Gate_Directory_User": {
            "type": "OpenApiConnection",
            "runAfter": {
              "Compose_Attachments_Gate_Caller": [
                "Succeeded"
              ]
            },
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                "connection": "shared_sharepointonline",
                "operationId": "GetItems"
              },
              "parameters": {
                "dataset": "https://nitdanigeria.sharepoint.com/sites/DGO_ECM_GOVERNANCE",
                "table": "3d591f5b-3f2f-409c-983a-a77b5c174834",
                "$filter": "@if(empty(outputs('Compose_Attachments_Gate_Caller')),'ID eq 0',concat('Email eq ''',replace(outputs('Compose_Attachments_Gate_Caller'),'''',''''''),''' and Status eq ''active'''))",
                "$top": 1
              }
            }
          },
          "Compose_Attachments_Gate_Auth": {
            "type": "Compose",
            "inputs": "@if(not(outputs('Compose_Attachments_Gate_Identity')?['proofRequired']),'ok',if(or(empty(outputs('Compose_Attachments_Gate_Caller')),empty(coalesce(outputs('Get_Attachments_Gate_Directory_User')?['body/value'],json('[]')))),'unauthenticated','ok'))",
            "runAfter": {
              "Get_Attachments_Gate_Directory_User": [
                "Succeeded"
              ]
            }
          }
        },
        "type": "Scope"
      },
      "Scope_Catch_Email_Attachments": {
        "actions": {
          "Set_Catch_Status": {
            "type": "SetVariable",
            "inputs": {
              "name": "varStatusCode",
              "value": 500
            }
          },
          "Set_Catch_Outcome": {
            "runAfter": {
              "Set_Catch_Status": [
                "Succeeded"
              ]
            },
            "type": "SetVariable",
            "inputs": {
              "name": "varOutcomeCode",
              "value": "EMAIL_ATTACHMENT_RETRIEVAL_FAILED"
            }
          },
          "Set_Catch_Data": {
            "runAfter": {
              "Compose_Value_Set_Catch_Data": [
                "Succeeded"
              ]
            },
            "type": "SetVariable",
            "inputs": {
              "name": "varData",
              "value": "@outputs('Compose_Value_Set_Catch_Data')"
            }
          },
          "Append_Catch_Error": {
            "runAfter": {
              "Set_Catch_Data": [
                "Succeeded"
              ]
            },
            "type": "AppendToArrayVariable",
            "inputs": {
              "name": "varErrors",
              "value": {
                "code": "DEPENDENCY_OR_PROCESSING_FAILURE",
                "message": "The email or its attachments could not be retrieved.",
                "stage": "email-attachment-processing",
                "trackedAtUtc": "@utcNow()"
              }
            }
          },
          "Compose_Value_Set_Catch_Data": {
            "type": "Compose",
            "inputs": {
              "emailId": "@trim(string(coalesce(triggerBody()?['emailId'],'')))",
              "attachmentCount": "@length(variables('varAttachments'))",
              "attachments": []
            },
            "runAfter": {
              "Set_Catch_Outcome": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "Scope_Try_Email_Attachments": [
            "Failed",
            "TimedOut"
          ]
        },
        "type": "Scope"
      },
      "Scope_Finalize_Email_Attachments": {
        "actions": {
          "Set_CompletedAtUtc": {
            "type": "SetVariable",
            "inputs": {
              "name": "varCompletedAtUtc",
              "value": "@utcNow()"
            }
          },
          "Set_DurationMs": {
            "runAfter": {
              "Set_CompletedAtUtc": [
                "Succeeded"
              ]
            },
            "type": "SetVariable",
            "inputs": {
              "name": "varDurationMs",
              "value": "@div(sub(ticks(variables('varCompletedAtUtc')),variables('varStartTicks')),10000)"
            }
          },
          "Compose_Standard_Response": {
            "runAfter": {
              "Set_DurationMs": [
                "Succeeded"
              ]
            },
            "type": "Compose",
            "inputs": {
              "ok": "@less(variables('varStatusCode'),400)",
              "status": {
                "http": "@variables('varStatusCode')",
                "code": "@variables('varOutcomeCode')",
                "message": "@if(less(variables('varStatusCode'),400),'Request completed successfully.','Request could not be completed.')"
              },
              "request": {
                "requestId": "@variables('varRequestId')",
                "emailId": "@trim(string(coalesce(triggerBody()?['emailId'],'')))"
              },
              "timing": {
                "receivedAtUtc": "@variables('varReceivedAtUtc')",
                "completedAtUtc": "@variables('varCompletedAtUtc')",
                "durationMs": "@variables('varDurationMs')"
              },
              "data": "@variables('varData')",
              "errors": "@variables('varErrors')",
              "meta": {
                "runId": "@workflow()?['run']?['name']",
                "flowName": "@workflow()?['name']",
                "contractVersion": "2026-09-18.1"
              }
            }
          },
          "Response_Email_Attachments": {
            "runAfter": {
              "Compose_Standard_Response": [
                "Succeeded"
              ]
            },
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": "@variables('varStatusCode')",
              "headers": {
                "Content-Type": "application/json",
                "Cache-Control": "no-store",
                "X-Content-Type-Options": "nosniff",
                "X-Correlation-ID": "@variables('varRequestId')"
              },
              "body": "@outputs('Compose_Standard_Response')"
            }
          }
        },
        "runAfter": {
          "Scope_Try_Email_Attachments": [
            "Succeeded",
            "Failed",
            "TimedOut"
          ],
          "Scope_Catch_Email_Attachments": [
            "Succeeded",
            "Skipped"
          ]
        },
        "type": "Scope"
      }
    },
    "runAfter": {},
    "type": "Scope"
  },
