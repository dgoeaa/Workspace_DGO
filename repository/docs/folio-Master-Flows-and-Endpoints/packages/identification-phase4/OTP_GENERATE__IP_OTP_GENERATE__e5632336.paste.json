ing:0 0 8px 0!important}.cell-r{text-align:left!important;padding:10px 0 0 0!important}.kv-l,.kv-v{display:block!important;width:100%!important;box-sizing:border-box}.kv-l{padding:10px 0 0 0!important;border-bottom:0!important}.kv-v{padding:2px 0 10px 0!important}.btn{float:none!important;width:100%!important;margin:0 0 10px 0!important}.btn td,.btn a{display:block!important;width:100%!important;box-sizing:border-box;text-align:center!important}.hdr-r{display:none!important}.outer{padding:0!important}}</style></head>\n<body style=\"margin:0;padding:0;background:#F5F4F4;\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">Your NITDA verification code. It expires in 5 minutes.&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#F5F4F4;\"><tr><td class=\"outer\" align=\"center\" style=\"padding:28px 12px;\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td><![endif]-->\n<table role=\"presentation\" class=\"container\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;border-collapse:separate;background:#FFFFFF;border:1px solid #E8E6E7;border-radius:14px;overflow:hidden;\">\n<tr><td class=\"px\" bgcolor=\"#05583B\" style=\"padding:24px 32px 22px;background:#05583B;border-bottom:3px solid #17B255\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td style=\"vertical-align:middle\"><img src=\"https://folio-portal.page.gd/email-assets/nitda-lockup-white.png\" width=\"140\" alt=\"NITDA — National Information Technology Development Agency\" style=\"display:block;width:140px;max-width:100%;height:auto;border:0;color:#FFFFFF;font-family:Verdana,sans-serif;font-size:13px\"></td><td align=\"right\" style=\"vertical-align:middle\"><img src=\"https://folio-portal.page.gd/email-assets/dgo-logo-whiteout.png\" width=\"150\" alt=\"DGO Digital Ops\" style=\"display:block;width:150px;max-width:100%;height:auto;border:0;color:#FFFFFF;font-family:Verdana,sans-serif;font-size:13px\"></td></tr></table></td></tr>\n<tr><td class=\"hero px\" style=\"padding:30px 32px 28px 32px;background:#022819;border-top:1px solid #CFE3D8;border-bottom:4px solid #45C578;\"><p style=\"margin:0 0 12px 0;\"><span style=\"display:inline-block;padding:5px 12px;border-radius:999px;background:#033F2A;border:1px solid #45C578;color:#FFFFFF;font-family:Verdana,Geneva,'DejaVu Sans',sans-serif;font-size:11px;line-height:15px;font-weight:700;letter-spacing:0.6px;text-transform:uppercase;white-space:nowrap;\">&#128274;&nbsp; NITDA verification</span></p><h1 class=\"h1\" style=\"margin:0;font-family:Outfit,'Segoe UI',Arial,sans-serif;font-size:27px;line-height:34px;font-weight:700;letter-spacing:-0.3px;color:#FFFFFF;word-break:break-word;overflow-wrap:anywhere;\">Your verification code</h1><p style=\"margin:10px 0 0 0;font-family:Verdana,Geneva,'DejaVu Sans',sans-serif;font-size:14px;line-height:22px;color:#CFE3D8;word-break:break-word;overflow-wrap:anywhere;\">Use the code below to complete your verification.</p></td>