      "Apply_to_each_Endpoint_Values_Record": {
        "type": "Foreach",
        "foreach": "@outputs('Compose_Endpoint_Values_Registry')",
        "operationOptions": "Sequential",
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 1
          }
        },
        "runAfter": {
          "Compose_Expected_Contract_Keys": [
            "Succeeded"
          ]
        },
        "actions": {
          "Scope_One_Endpoint_Values_Record": {
            "type": "Scope",
            "actions": {
              "List_Callback_URL_For_Values": {
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "environmentName": "@variables('EnvironmentName')",
                    "flowName": "@items('Apply_to_each_Endpoint_Values_Record')?['tenantFlowId']"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_flowmanagement",
                    "connection": "shared_flowmanagement",
                    "operationId": "ListCallbackUrl"
                  }
                }
              },
              "Compose_Values_Callback_URL": {
                "type": "Compose",
                "inputs": "@coalesce(outputs('List_Callback_URL_For_Values')?['body']?['response']?['value'], outputs('List_Callback_URL_For_Values')?['body']?['value'], '')",
                "runAfter": {
                  "List_Callback_URL_For_Values": [
                    "Succeeded",
                    "Failed",
                    "TimedOut",
                    "Skipped"
                  ]
                }
              },
              "Compose_Values_Observed_Workflow_Id": {
                "type": "Compose",
                "inputs": "@if(and(not(empty(outputs('Compose_Values_Callback_URL'))),contains(outputs('Compose_Values_Callback_URL'),'/workflows/')),first(split(last(split(outputs('Compose_Values_Callback_URL'),'/workflows/')),'/')),'')",
                "runAfter": {
                  "Compose_Values_Callback_URL": [
                    "Succeeded"
                  ]
                }
              },
              "Condition_Values_URL_Verifies": {
                "type": "If",
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@not(empty(outputs('Compose_Values_Callback_URL')))",
                        true
                      ]
                    },
                    {
                      "equals": [
                        "@contains(outputs('Compose_Values_Callback_URL'),'sig=')",
                        true
                      ]
                    },
                    {
                      "equals": [
                        "@equals(outputs('Compose_Values_Observed_Workflow_Id'),items('Apply_to_each_Endpoint_Values_Record')?['applicationWorkflowId'])",
                        true
                      ]
                    },
                    {
                      "equals": [
                        "@not(contains(variables('ValuesResolvedKeys'),items('Apply_to_each_Endpoint_Values_Record')?['contractKey']))",
                        true
                      ]
                    }
                  ]
                },
                "actions": {
                  "Append_Endpoint_Values_Line": {
                    "type": "AppendToArrayVariable",
                    "inputs": {
                      "name": "ValuesLines",
                      "value": "@concat(items('Apply_to_each_Endpoint_Values_Record')?['contractKey'],'=',outputs('Compose_Values_Callback_URL'))"
                    }
                  },
                  "Append_Endpoint_Values_Resolved_Key": {
                    "type": "AppendToArrayVariable",
                    "inputs": {
                      "name": "ValuesResolvedKeys",
                      "value": "@items('Apply_to_each_Endpoint_Values_Record')?['contractKey']"
                    },
                    "runAfter": {
                      "Append_Endpoint_Values_Line": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "else": {
                  "actions": {
                    "Append_Endpoint_Values_Rejection": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "ValuesRejections",
                        "value": {
                          "contractKey": "@items('Apply_to_each_Endpoint_Values_Record')?['contractKey']",
                          "flowName": "@items('Apply_to_each_Endpoint_Values_Record')?['flowName']",
                          "tenantFlowId": "@items('Apply_to_each_Endpoint_Values_Record')?['tenantFlowId']",
                          "candidate": "@concat(string(items('Apply_to_each_Endpoint_Values_Record')?['candidateOf']),' of ',string(items('Apply_to_each_Endpoint_Values_Record')?['candidates']))",
                          "evidence": "@items('Apply_to_each_Endpoint_Values_Record')?['evidence']",
                          "triggerAuthentication": "@items('Apply_to_each_Endpoint_Values_Record')?['triggerAuthentication']",
                          "diagnosis": "@if(equals(actions('List_Callback_URL_For_Values')?['status'],'Failed'),'THE_CALLBACK_CALL_ITSELF_FAILED - the flow id may be dead, or not owned by this connection',if(equals(outputs('Compose_Values_Observed_Workflow_Id'),items('Apply_to_each_Endpoint_Values_Record')?['applicationWorkflowId']),if(contains(outputs('Compose_Values_Callback_URL'),'sig='),'RESOLVED_BY_ANOTHER_CANDIDATE_OR_ALREADY_HELD',concat('RIGHT_FLOW_BUT_ITS_URL_CARRIES_NO_SIGNATURE - this trigger is ',items('Apply_to_each_Endpoint_Values_Record')?['triggerAuthentication'],'-authenticated. A browser with no proxy cannot call it. Set \"Who can trigger the flow\" to Anyone, or accept that this endpoint needs an Entra token.')),'SERVES_A_DIFFERENT_WORKFLOW - this flow is not the one the register names for this key'))",
                          "expectedApplicationWorkflowId": "@items('Apply_to_each_Endpoint_Values_Record')?['applicationWorkflowId']",
                          "observedApplicationWorkflowId": "@outputs('Compose_Values_Observed_Workflow_Id')",
                          "signaturePresent": "@contains(outputs('Compose_Values_Callback_URL'),'sig=')",
                          "callbackActionStatus": "@actions('List_Callback_URL_For_Values')?['status']",
                          "alreadyResolvedByAnotherCandidate": "@contains(variables('ValuesResolvedKeys'),items('Apply_to_each_Endpoint_Values_Record')?['contractKey'])"
                        }
                      }
                    }
                  }
                },
                "runAfter": {
                  "Compose_Values_Observed_Workflow_Id": [
                    "Succeeded"
                  ]
                }
              }
            }
          },
          "Scope_Endpoint_Values_Record_Failed": {
            "type": "Scope",
