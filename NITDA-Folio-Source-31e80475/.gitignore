# Dependencies
node_modules/

# Local runtime configuration — holds real Power Automate SAS URLs.
# A SAS URL is a credential; never commit these. Copy the matching
# config.example.js and fill it in locally instead.
config/config.local.js
document-portal/config.local.js
mailer/config.local.js

# Ad-hoc runtime state exports
*.state.json

# Test output
test-results/
playwright-report/
blob-report/
.playwright/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# The 17MB reference archive. Extracted to docs/reference/ and removed from the
# working tree — see docs/cutover/ARCHIVE_DISPOSITION.md. Still in git history.
ECM_DOCS_DEV.zip

# Built deployment packages (npm run package). Each carries a provisioned
# config.local.js — a credential. Never commit one.
dist/

# Package bundles (npm run package:bundle). These embed the endpoint
# configuration UNREDACTED — signed trigger URLs in full. Never commit one.
*.bundle.json
.scratch/
.scratch2/

# Written by scripts/provision-sharepoint-fields.ps1 — a run record, not source
sharepoint-field-ledger.csv

# Written by scripts/export-power-automate-flows.ps1 before review. Move exports you intend
# to keep into docs/folio-Master-Flows-and-Endpoints/contracts/ and attribute them in the register.
docs/folio-Master-Flows-and-Endpoints/contracts/exported/

# Generated by scripts/build-readiness-tracker.mjs. The published artifact is the live
# record once anyone edits it; a committed snapshot would be stale immediately.
readiness-tracker.html
dist-bundle/

# Python bytecode (tools/flow-workbench)
__pycache__/
*.pyc

# The single-file console export. Built on demand from docs/folio-Master-Flows-and-Endpoints/provisioning/
# by `npm run provisioningconsole:one`; the folder in docs/ is the committed form.
dist-console/

# Left behind by tests/mailer.e2e.mjs only when it fails, with a screenshot of the failure.
tests/.mailer-fixtures/

# estate-apply.cli.mjs output: flow backups and run reports (never commit)
estate-apply-output/

# npm run flows:update output: flow backups (they hold whole definitions) and run reports.
# Commit a report only through --record, which writes it to the evidence folder.
flows-update-output/

/flows.zip

# Folio Central Administration Centre state (tools/admin-centre). The database, the bootstrap
# token, backups and provisioning evidence are runtime state and hold a credential; never commit.
tools/admin-centre/data/
tools/admin-centre/config/admin.token
tools/admin-centre/config/*.tmp
tools/admin-centre/backups/
tools/admin-centre/evidence/
